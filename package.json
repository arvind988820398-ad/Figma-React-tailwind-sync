{
  "name": "ad-design-kit-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "lint:tokens": "node .claude/skills/ad-design-kit-review/scripts/lint-tokens.mjs src",
    "tokens:build": "node .claude/skills/ad-design-kit-design-system/scripts/build-tokens.mjs && cp .claude/skills/ad-design-kit-design-system/tokens/ad-design-kit.css src/styles/ad-design-kit.css && npm run docs:build",
    "storybook": "npm run docs:build && storybook dev -p 6006",
    "build-storybook": "npm run docs:build && storybook build",
    "storybook:deploy": "npm run build-storybook && npx -y netlify-cli deploy --prod --dir storybook-static --no-build --site 5c4cfb1c-721f-4500-aca8-f53b0d116efc",
    "test": "vitest run --project storybook",
    "test:coverage": "vitest run --project storybook --coverage",
    "docs:build": "node .storybook/scripts/build-docs.mjs",
    "docs:check": "node .storybook/scripts/build-docs.mjs --check",
    "figma:descriptions": "node .claude/skills/ad-design-kit-figma-sync/scripts/build-figma-descriptions.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-mcp": "^10.6.4",
    "@storybook/addon-vitest": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "oxlint": "^1.88.0",
    "playwright": "latest",
    "storybook": "^10.6.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "latest"
  }
}
