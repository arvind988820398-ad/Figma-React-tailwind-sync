        "effects": 22,
        "components": 58,
        "icons": 447
      },
      "changes": [
        {
          "area": "code",
          "change": "changed",
          "name": "Dropdown, Popover, Tooltip, Autocomplete and Datepicker are positioned with Floating UI: they flip and shift to stay on screen and are no longer clipped by a parent with overflow hidden (Table, Card, Drawer). New dependency @floating-ui/react-dom."
        },
        {
          "area": "code",
          "change": "changed",
          "name": "The npm package marks its interactive modules \"use client\", so it builds in the Next.js App Router; presentational components (Badge, Button, Card, Table…) stay Server Components."
        },
        {
          "area": "code",
          "change": "changed",
          "name": "The package no longer requires Node 24 to install (the requirement moved to devEngines, for this repository only)."
        }
      ]
